# Backend (Feedback-to-Opportunity-Map) origin. Used by the dev/prod server to proxy
# /backend-api/* -> $BACKEND_URL/api/*  (no CORS setup needed). Not exposed to the browser.
BACKEND_URL=http://localhost:3000

# Optional: make the browser call the backend directly instead of using the proxy.
# Leave empty normally. If set, the backend must allow your frontend origin (it allows * by default).
NEXT_PUBLIC_API_URL=
